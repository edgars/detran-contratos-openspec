# Banco SQLite (caminho relativo a prisma/schema.prisma)
DATABASE_URL="file:../data/app.db"
# Origem do frontend autorizada no CORS da API
APP_ORIGIN="http://localhost:3000"
# Porta HTTP do app
PORT=3000
# Assinatura da sessão (gere com: openssl rand -base64 32)
AUTH_SECRET=""
# Anexos: pasta fora de public/ e limite em MB
UPLOAD_DIR="data/uploads"
UPLOAD_MAX_MB=10
# Usuário inicial, criado no primeiro login só se a tabela users estiver vazia
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""
# Cookie de sessão: COOKIE_SECURE="false" só para acesso por HTTP sem TLS.
# COOKIE_SAMESITE="none" só para abrir o app dentro de um iframe (exige HTTPS).
COOKIE_SECURE=""
COOKIE_SAMESITE=""
