# ============================================================================
# Desenvolvimento (npm run dev) e base comum
# ============================================================================
# Banco SQLite (caminho relativo a prisma/schema.prisma). Em produção o compose fixa file:/app/data/app.db.
DATABASE_URL="file:../data/app.db"
# Origem do frontend autorizada no CORS da API. Em produção: https://<SITE_ADDRESS> (obrigatório https://).
APP_ORIGIN="http://localhost:3000"
# Porta HTTP do app em desenvolvimento (em produção o app não publica porta; só o proxy).
PORT=3000
# Assinatura da sessão, ao menos 32 bytes (gere com: openssl rand -base64 32). Obrigatória.
AUTH_SECRET=""
# Anexos: pasta fora de public/ (em produção o compose fixa /app/data/uploads) e limite em MB (inteiro).
UPLOAD_DIR="data/uploads"
UPLOAD_MAX_MB=10
# Usuário inicial, criado no primeiro login só se a tabela users estiver vazia.
# Em produção: preencha só para o primeiro acesso e APAGUE ADMIN_PASSWORD depois (o app avisa no log).
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""
# Cookie de sessão: COOKIE_SECURE="false" só para acesso por HTTP sem TLS, FORA de produção
# (em produção o app recusa subir com false). COOKIE_SAMESITE: vazio (lax) ou "none" só para a prévia em iframe.
COOKIE_SECURE=""
COOKIE_SAMESITE=""

# ============================================================================
# Produção (026-producao) — docker compose up -d --build; runbook em docs/operacao.md
# ============================================================================
# Versão em uso (tag git, ex.: v1.0.0): nome da imagem detran-contratos:<APP_VERSION>. atualizar.sh a troca.
APP_VERSION="dev"
# Nome DNS do sistema, atendido pelo proxy Caddy (portas 80 e 443).
SITE_ADDRESS="contratos.detran.rj.gov.br"
# TLS do proxy: "/certs/fullchain.pem /certs/privkey.pem" (certificado do órgão em ./certs),
# um e-mail (certificado público ACME automático; exige DNS público e 80/443 abertas) ou "internal" (só homologação).
CADDY_TLS="/certs/fullchain.pem /certs/privkey.pem"
# E-mail técnico do órgão para o ACME (só com certificado automático).
ACME_EMAIL=""
# Limite de corpo no proxy, em MB (1024²): maior que UPLOAD_MAX_MB (overhead do multipart) e no máximo 100. Acima dele: 413.
PROXY_MAX_BODY_MB=11
# Origens https:// autorizadas a abrir o sistema em iframe (prévia), separadas por espaço. Padrão: vazio.
FRAME_ANCESTORS=""
# Nível do log JSON do app: debug, info, warn ou error.
LOG_LEVEL="info"
# Pastas montadas no proxy e no backup (padrão: ./certs e ./secrets/backup ao lado do docker-compose.yml).
CERTS_DIR="./certs"
BACKUP_SECRETS_DIR="./secrets/backup"
# Arquivo de ambiente lido pelos serviços (padrão: este .env).
ENV_FILE=".env"

# --- Backup (serviço backup) ---
# Fuso do cron do backup.
TZ="America/Sao_Paulo"
# Horário do backup diário (formato cron).
BACKUP_HORARIO="0 2 * * *"
# Retenção: backups diários mais recentes e meses com o primeiro backup guardado.
BACKUP_RETENCAO_DIARIA=14
BACKUP_RETENCAO_MENSAL=6
# Destino externo do rsync sobre SSH (usuario@servidor:/pasta). Obrigatório em produção; vazio só gera erro no log.
# A chave (id_ed25519) e o known_hosts do destino ficam em BACKUP_SECRETS_DIR, com permissão 600.
BACKUP_REMOTE=""
# Porta SSH do destino, se não for a 22.
BACKUP_SSH_PORTA=""
