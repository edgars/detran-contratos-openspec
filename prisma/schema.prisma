// Modelo de dados — openspec/changes/001-project-foundation/design.md § Modelo de dados.
// Esta change cria só as tabelas de referência; cada change de entidade adiciona a sua tabela
// numa migração própria. Valores monetários serão Decimal (diretiva do autor em openspec/config.yaml).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Tabela de referência — somente leitura (001-project-foundation, app-shell).
model Diretoria {
  id            Int            @id @default(autoincrement())
  deDiretoria   String
  codigo        String
  departamentos Departamento[]

  @@map("diretorias")
}

/// Tabela de referência — somente leitura (001-project-foundation, app-shell).
model PessoaFisica {
  id                     Int       @id @default(autoincrement())
  idPessoaFisica         Int
  /// CPF com 11 dígitos, sem pontuação (chave do legado `PessoaFisica.CPF`; 022-pessoas-fornecedores).
  cpf                    String?   @unique
  deNome                 String?
  deEndereco             String?
  deBairro               String?
  deTelefone             String?
  deNomePai              String?
  deNomeMae              String?
  deNaturalidade         String?
  deUrlFoto              String?
  prestadorServico       String?
  cep                    String?
  pseudonimo             String?
  nuExtraQuadro          String?
  nuRegistro             String?
  nuMatricula            String?
  identidadeFuncional    String?
  vinculo                Int?
  flTermoImpresso        String?
  flFuncionarioPublico   String?
  flConformidadeTermo    String?
  flEmitirCracha         String?
  flAprovado             String?
  flAposentado           Int?
  dtNascimento           DateTime
  dtInclusaoTermo        DateTime?
  dtTermoRecebido        DateTime?
  dtTermoPreAprovado     DateTime?
  dtCracha               DateTime?
  dtCorregedoria         DateTime?
  dtInformatica          DateTime?
  dtExcluido             DateTime?
  dtUltimaAlteracaoTermo DateTime?
  foto                   String?
  municipioId            Int?
  cargoId                Int?
  tipoSanguineoId        Int?
  departamentoId         Int?
  lotacaoId              Int?
  lotacaoOrigemId        Int?
  ufId                   String?
  orgaoExpedidorId       Int?
  origemExternaId        Int?
  nacionalidadeId        Int?
  guiaRemessaId          Int?
  guiaRemessaCrachaId    Int?
  usuarioCorregedoriaId  Int?
  usuarioDpId            Int?
  flAlteracao            Int?
  deObservacao           String?
  deSimbolo              String?
  dtPublicDoerj          DateTime?
  dtValidade             DateTime?
  dtNomeacao             DateTime?
  dtPosse                DateTime?
  dtExercicio            DateTime?
  flPublicadoDoerj       String?
  dtPublicDoerjN         DateTime?
  lotacaoCgpId           Int?

  @@map("pessoas_fisicas")
}

/// Tabela de referência — somente leitura (001-project-foundation, app-shell).
model Pessoa {
  id   Int     @id @default(autoincrement())
  cpf  String?
  cnpj String?

  @@map("pessoas")
}

/// Tabela de referência — somente leitura (001-project-foundation, app-shell).
model PrestadorServico {
  id            Int        @id @default(autoincrement())
  deRazaoSocial String
  /// CNPJ com 14 dígitos, sem pontuação (chave do legado `PrestadorServico.CNPJ`; 022-pessoas-fornecedores).
  cnpj          String?    @unique
  contratos     Contrato[]

  @@map("prestadores_servicos")
}

/// Tabela de referência — somente leitura (001-project-foundation, app-shell).
model GroupUser {
  id      Int  @id @default(autoincrement())
  groupId Int
  userId  Int
  acoId   Int?

  @@map("groups_users")
}

/// Tabela de referência — somente leitura (001-project-foundation, app-shell).
model PagamentoArquivo {
  id          Int    @id @default(autoincrement())
  arquivo     String
  pagamentoId Int

  @@map("pagamento_arquivos")
}

/// Tabela de referência — somente leitura (001-project-foundation, app-shell).
model Group {
  id        Int       @id @default(autoincrement())
  name      String
  created   DateTime?
  modified  DateTime?
  acoId     Int?
  descricao String?

  @@map("groups")
}

/// Usuários (tabela de 005-users; criada em 001b-security-baseline por causa do passwordHash).
model User {
  id           Int         @id @default(autoincrement())
  username     String      @unique
  passwordHash String
  created      DateTime?   @default(now())
  modified     DateTime?   @updatedAt
  /// Obrigatório no legado; opcional aqui até a relação com `pessoas` ser confirmada.
  pessoaId     Int?
  superuser    Int?
  inativo      Int?
  ultimoLogin  DateTime?
  sessions     Session[]
  historicos   Historico[] @relation("HistoricoUsuario")
  /// Perfis de acesso (023-perfis-acesso); um usuário pode ter mais de um.
  perfis       UserPerfil[]

  @@map("users")
}

/// Perfil de acesso de um usuário (023-perfis-acesso). `perfil` é um de ADMINISTRADOR, GESTOR_CONTRATO,
/// FISCAL, FINANCEIRO, CONSULTA (CHECK na migração; z.enum na API).
model UserPerfil {
  id     Int    @id @default(autoincrement())
  userId Int
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  perfil String

  @@unique([userId, perfil])
  @@index([userId])
  @@map("user_perfis")
}

/// Sessões emitidas pelo servidor (001b-security-baseline). `id` guarda o hash do token.
model Session {
  id        String   @id
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
  @@map("sessions")
}

model Departamento {
  id             Int        @id @default(autoincrement())
  deDepartamento String
  codigo         String?
  deLogradouro   String?
  deComplemento  String?
  deBairro       String?
  deCidade       String?
  cep            String?
  diretoriaId    Int
  diretoria      Diretoria  @relation(fields: [diretoriaId], references: [id])
  municipioId    Int?
  contratos      Contrato[]

  @@map("departamentos")
}

model TipoContrato {
  id                  Int        @id @default(autoincrement())
  nome                String?
  gerenciamento       String
  indicativoMetaRisco String     @default("N")
  /// 021: tipo sujeito à prestação de contas ("S"/"N").
  prestacaoContas     String     @default("N")
  /// 019: tipo tratado como "Contrato" nos relatórios ("S"/"N").
  contratoPrincipal   String     @default("N")
  contratos           Contrato[]

  @@map("tipo_contrato")
}

model ContratoStatus {
  id           Int       @id @default(autoincrement())
  contratoId   Int
  statusId     Int
  dataInclusao DateTime?
  descricao    String?
  usuarioId    Int?
  atendido     Int?
  aditivoId    Int?

  @@map("contrato_status")
}

model Pagamento {
  id             Int      @id @default(autoincrement())
  competencia    DateTime
  numeroProcesso String
  contratoId     Int
  valor          Decimal?
  empenho        String?
  notaFiscal     String?
  notaLiquidacao String?
  ordemBancaria  String?
  glosa          String?
  valorGlosa     Decimal?
  mes            String?
  ano            String?

  @@map("pagamentos")
}

model Modalidade {
  id        Int        @id @default(autoincrement())
  nome      String?
  contratos Contrato[]

  @@map("modalidades")
}

model PrestacaoConta {
  id           Int       @id @default(autoincrement())
  descricao    String?
  atendido     String?
  dataInclusao DateTime?
  faseId       Int
  userId       Int
  contratoId   Int

  @@map("prestacao_contas")
}

model Fase {
  id      Int    @id @default(autoincrement())
  nome    String
  periodo String

  @@map("fases")
}

model Fiscal {
  id              Int       @id @default(autoincrement())
  contratoId      Int
  pessoaFisicaCpf String
  suplente        String
  dataInclusao    DateTime?
  presidente      String

  @@map("fiscais")
}

model Status {
  id      Int     @id @default(autoincrement())
  nome    String?
  fluxo   String?
  periodo Int?

  @@map("status")
}

model Historico {
  id           Int       @id @default(autoincrement())
  contratoId   Int
  dataInclusao DateTime?
  descricao    String?
  usuarioId    Int?
  usuario      User?     @relation("HistoricoUsuario", fields: [usuarioId], references: [id])

  @@map("historicos")
}

model AnexoFiscal {
  id           Int      @id @default(autoincrement())
  anexo        String
  dataRegistro DateTime
  contratoId   Int

  @@map("anexos_fiscais")
}

model SituacaoContratual {
  id        Int        @id @default(autoincrement())
  descricao String?
  contratos Contrato[]

  @@map("situacao_contratual")
}

model AnexoPublicacao {
  id             Int      @id @default(autoincrement())
  anexo          String?
  contratoId     Int
  dataPublicacao DateTime

  @@map("anexos_publicacao")
}

model Penalidade {
  id           Int      @id @default(autoincrement())
  dataRegistro DateTime
  arquivo      String?
  contratoId   Int
  userId       Int

  @@map("penalidades")
}

model Contrato {
  id                   Int                 @id @default(autoincrement())
  numeroProcesso       String?
  numeroContrato       String?
  periodo              String?
  parentId             Int?
  parent               Contrato?           @relation("Aditivos", fields: [parentId], references: [id])
  aditivos             Contrato[]          @relation("Aditivos")
  dataInclusao         DateTime?
  dataInicio           DateTime?
  dataTermino          DateTime?
  valorInicial         Decimal?
  valorMensal          Decimal?
  valorTotal           Decimal?
  departamentoId       Int?
  departamento         Departamento?       @relation(fields: [departamentoId], references: [id])
  pessoaFisicaId       String?
  suplenteId           String?
  prestadorServicoId   Int?
  prestadorServico     PrestadorServico?   @relation(fields: [prestadorServicoId], references: [id])
  tipoContratoId       Int?
  tipoContrato         TipoContrato?       @relation(fields: [tipoContratoId], references: [id])
  modalidadeId         Int?
  modalidade           Modalidade?         @relation(fields: [modalidadeId], references: [id])
  situacaoContratualId Int?
  situacaoContratual   SituacaoContratual? @relation(fields: [situacaoContratualId], references: [id])
  objeto               String
  anexoTipo            String?
  anexo                String?
  projetoBasico        String?
  numeroModalidade     String?
  naPresidencia        Int?
  prestacaoRealizada   String?
  numeroFiscais        String?

  @@map("contratos")
}

/// Valores antigos que uma migração não conseguiu converter (022-pessoas-fornecedores, D7); a 025 pode reaproveitar.
model MigracaoPendencia {
  id          Int       @id @default(autoincrement())
  origem      String
  tabela      String
  registroId  Int
  campo       String
  valorAntigo String?
  motivo      String
  criadoEm    DateTime  @default(now())
  resolvidoEm DateTime?

  @@index([origem, resolvidoEm])
  @@map("migracao_pendencias")
}
